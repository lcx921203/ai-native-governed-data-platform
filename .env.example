# -----------------------------------------------------------------------------
# Local Runtime Validation
# -----------------------------------------------------------------------------
POLARIS_IMAGE=apache/polaris:1.7.0
RUSTFS_IMAGE=rustfs/rustfs:1.0.0-beta.8
SPARK_IMAGE=apache/spark:3.5.6-java17
TRINO_IMAGE=trinodb/trino:483
AWS_CLI_IMAGE=amazon/aws-cli:2.36.8
CURL_IMAGE=alpine/curl:8.21.0

POLARIS_REALM=POLARIS
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=s3cr3t
POLARIS_CATALOG_NAME=commerce_catalog

RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
WAREHOUSE_BUCKET=commerce-lakehouse
S3_REGION=us-west-2

# Host-facing endpoints.
POLARIS_URI=http://localhost:8181/api/catalog
S3_ENDPOINT=http://localhost:9000
SPARK_THRIFT_HOST=localhost
SPARK_THRIFT_PORT=10000
TRINO_HOST=localhost
TRINO_PORT=8088
TRINO_USER=serving_api
TRINO_CATALOG=iceberg
TRINO_SCHEMA=serving
TRINO_HTTP_SCHEME=http
SERVING_API_PORT=8081

# Fixed BI/API Serving export is fail-closed until explicitly enabled in runtime.
SERVING_ALLOW_METRIC_EXPORT=false
# 只有真实跑 MetricFlow → Iceberg → Trino → FastAPI 对账时才打开。
SERVING_ALLOW_RUNTIME_ACCEPTANCE=false
# 最终 Runtime Closure 需要显式指定一个已准备好上游数据的业务日。
SERVING_ACCEPTANCE_PARTITION_KEY=
SERVING_METRICFLOW_BIN=
SERVING_METRICFLOW_TIMEOUT_SECONDS=900

# -----------------------------------------------------------------------------
# Shopify API (used later for real extraction; fixtures do not need these)
# -----------------------------------------------------------------------------
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=replace_me
SHOPIFY_API_VERSION=2026-07
# Raw 数据源模式：本地默认 fixture；生产显式改成 production。
SHOPIFY_SOURCE_MODE=fixture
SHOPIFY_PAGE_SIZE=100
SHOPIFY_NESTED_PAGE_SIZE=100
SHOPIFY_API_TIMEOUT_SECONDS=60
SHOPIFY_API_MAX_RETRIES=5
SHOPIFY_API_BACKOFF_BASE_SECONDS=1.0
SHOPIFY_THROTTLE_RESERVE_POINTS=20
SHOPIFY_ENFORCE_API_VERSION=true
SHOPIFY_API_LANDING_DIR=.runtime/shopify-api
SHOPIFY_NESTED_PAGINATION=true


# -----------------------------------------------------------------------------
# MySQL CDC / Behavior Streaming — production-oriented source settings
# -----------------------------------------------------------------------------
MYSQL_HOST=mysql.internal
MYSQL_PORT=3306
MYSQL_DATABASE=commerce_master
MYSQL_CDC_USER=flink_cdc
MYSQL_CDC_PASSWORD=replace_me
MYSQL_SERVER_TIME_ZONE=UTC

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
BEHAVIOR_KAFKA_TOPIC=commerce.behavior.events
BEHAVIOR_KAFKA_GROUP_ID=behavior-lakehouse-v1
BEHAVIOR_KAFKA_ACK_TIMEOUT_SECONDS=10
BEHAVIOR_COLLECTOR_CLIENT_ID=behavior-collector
BEHAVIOR_KAFKA_COMPRESSION=lz4

# Event-time policy: 2m bounded disorder + 1m idle partition + 5m allowed lateness.
BEHAVIOR_MAX_OUT_OF_ORDERNESS_SECONDS=120
BEHAVIOR_IDLE_PARTITION_SECONDS=60
BEHAVIOR_ALLOWED_LATENESS_SECONDS=300
BEHAVIOR_DEDUP_STATE_TTL_HOURS=24

# Fault tolerance. Local runtime can point these S3 URIs at RustFS via Flink S3 config.
FLINK_CHECKPOINT_INTERVAL_MS=60000
FLINK_CHECKPOINT_TIMEOUT_MS=600000
FLINK_CHECKPOINT_MIN_PAUSE_MS=30000
FLINK_CHECKPOINT_STORAGE=s3://commerce-lakehouse/flink/checkpoints/behavior
FLINK_SAVEPOINT_STORAGE=s3://commerce-lakehouse/flink/savepoints/behavior
FLINK_RESTART_ATTEMPTS=3
FLINK_RESTART_DELAY_MS=10000
FLINK_ENABLE_UNALIGNED_CHECKPOINTS=false

# Phase 5G comparative semantic query runtime gate
PHASE5G_ALLOW_COMPARATIVE_QUERY=false

# Phase 5H governed comparative breakdown / contribution runtime gate
PHASE5H_ALLOW_BREAKDOWN_QUERY=false

# -----------------------------------------------------------------------------
# Governed Agent / Semantic Query runtime gates — default fail-closed
# -----------------------------------------------------------------------------
PHASE4G_ALLOW_OPENAI_CALL=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MAX_OUTPUT_TOKENS=1200

PHASE5B_ALLOW_METRICFLOW_QUERY=false
PHASE5C_ALLOW_METRICFLOW_DISCOVERY=false
PHASE5D_ALLOW_DIMENSION_RESOLUTION=false
PHASE5E_ALLOW_CONTINUATION_EXECUTION=false
PHASE5F_ALLOW_SESSION_EXECUTION=false
# Existing comparison/breakdown gates above remain false by default.
PHASE4C_ALLOW_DATAHUB_WRITE=false

# Phase 6A governed anomaly detection runtime gate
PHASE6A_ALLOW_ANOMALY_QUERY=false

# Phase 6B governed driver-attribution runtime gate
PHASE6B_ALLOW_DRIVER_ATTRIBUTION=false

# Phase 6C governed diagnostic orchestration runtime gate
PHASE6C_ALLOW_DIAGNOSTIC=false

PHASE6D_ALLOW_INCIDENT_DRILLDOWN=false

# Phase 6E — advisory incident-response planning only; no Dagster write authority.
PHASE6E_ALLOW_INCIDENT_RESPONSE_PLANNING=false

# Phase 6F — approval state/audit only. APPROVED does not execute a production action.
PHASE6F_ALLOW_APPROVAL_WORKFLOW=false
PHASE6F_ALLOW_APPROVAL_AUDIT_WRITE=false

# -----------------------------------------------------------------------------
# Phase 7 runtime cutover / knowledge / final-closure gates — default fail-closed
# -----------------------------------------------------------------------------
PHASE7A_ALLOW_RUNTIME_BOOTSTRAP=false
PHASE7A_ALLOW_DATAHUB_BOOTSTRAP=false
PHASE7A_ALLOW_DATAHUB_GOVERNANCE_WRITE=false
PHASE7A_ALLOW_AGENT_DATAHUB_READ=false
PHASE7A_ALLOW_AGENT_SEMANTIC_RUNTIME=false
PHASE7A_ALLOW_AGENT_DAGSTER_READ=false
PHASE7A_ALLOW_OPENAI_PROVIDER=false
PHASE7B_ALLOW_KNOWLEDGE_REINDEX=false
PHASE7B_ALLOW_KNOWLEDGE_RETRIEVAL=false
PHASE7B_ALLOW_KNOWLEDGE_RERANK=false
PHASE7C_ALLOW_MCP_RUNTIME=false
PHASE7_ALLOW_FINAL_RUNTIME_CLOSURE=false
COHERE_API_KEY=
DATAHUB_GMS_URL=http://localhost:8080


# Phase 7C MCP runtime (no secrets in source)
COMMERCE_MCP_PROFILE=analyst
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_AUTH_ISSUER=
MCP_RESOURCE_URL=http://127.0.0.1:8000/mcp
MCP_AUDIENCE=
MCP_JWKS_URL=
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
MCP_ALLOWED_ORIGINS=http://localhost:*
MCP_ACCEPTANCE_URL=http://127.0.0.1:8000/mcp
MCP_ACCEPTANCE_TOKEN=

# Serving DataHub governance / lineage extension (all real writes default fail closed)
SERVING_GOVERNANCE_ALLOW_DATAHUB_WRITE=false
SERVING_GOVERNANCE_ALLOW_LINEAGE_WRITE=false
SERVING_GOVERNANCE_ALLOW_CONSUMER_WRITE=false

# OpenAPI ingestion 后从 DataHub 实体复制的 exact Endpoint Dataset URN；禁止按名称猜测。
SERVING_API_EXECUTIVE_DAILY_URN=
SERVING_API_REGION_DAILY_URN=
