{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commerce Governed LLM Answer Draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "used_claim_ids", "acknowledged_limitations"],
  "properties": {
    "answer": {"type": "string", "minLength": 1},
    "used_claim_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^C[0-9]{2}$"},
      "uniqueItems": true,
      "maxItems": 8
    },
    "acknowledged_limitations": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  }
}
