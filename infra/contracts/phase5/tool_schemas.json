{
  "contract": "commerce_agent_tool_schemas",
  "version": 2,
  "tools": [
    {"name":"search_metadata","description":"Search governed Commerce metadata.","parameters":{"type":"object","properties":{"query":{"type":"string"},"limit":{"type":"integer","minimum":1,"maximum":25,"default":10}},"required":["query"],"additionalProperties":false}},
    {"name":"get_entity_context","description":"Return governed entity context.","parameters":{"type":"object","properties":{"entity":{"type":"string"}},"required":["entity"],"additionalProperties":false}},
    {"name":"get_metric_context","description":"Return governed metric definition and MetricFlow semantics.","parameters":{"type":"object","properties":{"metric":{"type":"string"}},"required":["metric"],"additionalProperties":false}},
    {"name":"get_dataset_context","description":"Return governed dataset context.","parameters":{"type":"object","properties":{"dataset":{"type":"string"}},"required":["dataset"],"additionalProperties":false}},
    {"name":"get_lineage_context","description":"Return bounded lineage context.","parameters":{"type":"object","properties":{"dataset":{"type":"string"},"direction":{"type":"string","enum":["upstream","downstream"],"default":"upstream"},"max_hops":{"type":"integer","minimum":1,"maximum":2,"default":2}},"required":["dataset"],"additionalProperties":false}},
    {"name":"get_runtime_context","description":"Return automation contract and verified runtime facts when available.","parameters":{"type":"object","properties":{"dataset":{"type":"string"}},"required":["dataset"],"additionalProperties":false}},
    {"name":"query_semantic_metric","description":"Query one governed metric through MetricFlow with explicit time context.","parameters":{"type":"object","properties":{"metric":{"type":"string"},"question":{"type":"string"},"limit":{"type":"integer","minimum":1,"maximum":50,"default":20}},"required":["metric","question"],"additionalProperties":false}},
    {"name":"query_semantic_metrics","description":"Query two or three governed metrics through one bounded MetricFlow plan.","parameters":{"type":"object","properties":{"metrics":{"type":"array","items":{"type":"string"},"minItems":2,"maxItems":3,"uniqueItems":true},"question":{"type":"string"},"limit":{"type":"integer","minimum":1,"maximum":50,"default":20}},"required":["metrics","question"],"additionalProperties":false}},
    {"name":"get_dimension_values","description":"Discover governed dimension values for one to three metrics.","parameters":{"type":"object","properties":{"metrics":{"type":"array","items":{"type":"string"},"minItems":1,"maxItems":3,"uniqueItems":true},"dimension":{"type":"string","enum":["store__region","store__state","store__country","item__brand","item__category","item__subcategory"]},"question":{"type":"string"},"limit":{"type":"integer","minimum":1,"maximum":50,"default":25}},"required":["metrics","dimension"],"additionalProperties":false}},
    {"name":"resolve_dimension_value","description":"Resolve one raw business value to a governed dimension value; fuzzy candidates never auto-apply.","parameters":{"type":"object","properties":{"metrics":{"type":"array","items":{"type":"string"},"minItems":1,"maxItems":3,"uniqueItems":true},"raw_value":{"type":"string","minLength":1,"maxLength":128},"dimension":{"type":["string","null"],"enum":["store__region","store__state","store__country","item__brand","item__category","item__subcategory",null]},"question":{"type":"string"}},"required":["metrics","raw_value"],"additionalProperties":false}}
  ]
}
